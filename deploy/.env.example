# deploy/.env にコピーして埋めてください。.env は絶対にコミットしないこと(.gitignore 済み)。

# DuckDNS で取った名前(例 my-orbit.duckdns.org)
ORBIT_DOMAIN=
# 同じものに https:// をつけたもの
ORBIT_PUBLIC_URL=
# 入口の画面を置いている GitHub Pages
ORBIT_ALLOWED_ORIGINS=https://zenhansha.github.io

# 長いランダムな文字列(setup-oracle.sh が自動で入れます。自分で作るなら: openssl rand -hex 32)
# 変えると、ログイン中の人は入り直しになり、届いている承認メールのリンクも使えなくなります
ORBIT_SECRET=

# 承認メールの送り先(Resend に登録したアドレス)
ORBIT_OWNER_EMAIL=
# https://resend.com の API キー(無料プラン)
RESEND_API_KEY=
ORBIT_MAIL_FROM=Orbit <onboarding@resend.dev>

# 管理者ログイン。この ID とパスワードで go から入ると、ブラウザではなく管理画面が開きます。
# 承認・却下、管理者の追加、各種設定の変更ができます。空のままだと管理者ログインは無効。
# パスワードはこのファイル(サーバーの中だけ)にあり、公開リポジトリには残りません。強めのものにしてください。
ORBIT_ADMIN_ID=
ORBIT_ADMIN_PASSWORD=

# 上限(なくても動きます)
ORBIT_TABS_PER_USER=3
ORBIT_TABS_TOTAL=10
ORBIT_IDLE_MINUTES=10
ORBIT_SESSION_MINUTES=60
ORBIT_PASSWORD_MIN_LENGTH=8

# 小さいサーバー(1GBの E2.1.Micro など)で動かすときは 1 にする。
# Chromium のプロセス数やキャッシュを減らしてメモリを節約します(そのぶん分離は弱くなるので、
# 人数が多いサーバーでは 0 のまま)。docker-compose.micro.yml を使うと自動で 1 になります。
ORBIT_LOW_MEMORY=0
