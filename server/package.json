{
  "name": "orbit-server",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit: remote-rendered anonymous browser backend",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
